PORT=3000
CLIENT_ORIGIN=http://localhost:5500
JWT_SECRET=replace-with-a-long-random-secret

# Supabase Connect -> Transaction pooler connection string.
# Keep this secret and never place it in frontend JavaScript.
DATABASE_URL=postgresql://postgres.project-ref:database-password@aws-0-region.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_SIZE=5

# Supabase Auth verification for Google sign-in. The publishable key is not a secret,
# but never use the service_role/secret key here or in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Generic SMS provider settings. Configure these for your chosen Philippine SMS provider.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=School
SMS_CLIENT_TOKEN=replace-with-a-private-client-token
